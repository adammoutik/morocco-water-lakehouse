# ==========================================
# 1. Secrets & Credentials (CRITICAL)
# ==========================================
# Never commit your MINIO keys, passwords, or API tokens
.env
.env.*
*.pem

# ==========================================
# 2. Virtual Environments
# ==========================================
# These folders are massive and specific to your computer
.venv/
venv/
env/
/env/

# ==========================================
# 3. Python Cache & Compiled Files
# ==========================================
# Python generates these automatically, no need to save them
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# 4. Testing & Coverage
# ==========================================
# Generated when you run your pytest commands
.pytest_cache/
.coverage
htmlcov/
.tox/

# ==========================================
# 5. Local Data & Logs
# ==========================================
# Do not commit raw Excel, CSV, or Parquet files to GitHub
# Your code should download them, not store them in the repo
*.csv
*.xlsx
*.parquet
*.json
/data/
/tmp/
*.log

# ==========================================
# 6. IDE & OS Files
# ==========================================
# Files created by VS Code or Windows
.vscode/
.idea/
Thumbs.db
.DS_Store